server {
    listen ${PORT} default_server;

    client_max_body_size 100M;
    charset utf-8;

    # Re-resolve upstream DNS every 10s (prevents stale IPs after service redeploy)
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    # Frontend
    location / {
        set $upstream_front http://taiga-front.railway.internal:80;
        proxy_pass $upstream_front$request_uri;
        proxy_pass_header Server;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
    }

    # API
    location /api/ {
        set $upstream_back http://taiga-back.railway.internal:8000;
        proxy_pass $upstream_back$request_uri;
        proxy_pass_header Server;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
    }

    # Admin
    location /admin/ {
        set $upstream_back http://taiga-back.railway.internal:8000;
        proxy_pass $upstream_back$request_uri;
        proxy_pass_header Server;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
    }

    # Static files - proxied to backend (whitenoise serves them)
    location /static/ {
        set $upstream_back http://taiga-back.railway.internal:8000;
        proxy_pass $upstream_back$request_uri;
        proxy_pass_header Server;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;
    }

    # Media files - proxied to backend (Django serves them)
    location /media/ {
        set $upstream_back http://taiga-back.railway.internal:8000;
        proxy_pass $upstream_back$request_uri;
        proxy_pass_header Server;
        proxy_set_header Host $http_host;
        proxy_redirect off;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Scheme $scheme;

        # Headers críticos para transferencia binaria
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Connection "";

        # Preservar headers de respuesta de Django
        proxy_pass_header Content-Type;
        proxy_pass_header Content-Length;
        proxy_pass_header Content-Disposition;
    }
}
